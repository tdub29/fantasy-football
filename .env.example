# =======================================================================
# Per-project secrets for MCP servers wired into .mcp.json / .cursor/mcp.json
# Copy to .env (gitignored), fill in keys you actually need. Empty values
# disable that MCP server gracefully.
# =======================================================================

# --- Neon Postgres ---------------------------------------------------------
# Not required if you use the remote MCP's OAuth flow.
# Only set this if you want to use a service-account bearer token instead.
# NEON_API_KEY=napi_...

# --- fal.ai (Genmedia image/video) -----------------------------------------
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Slack ----------------------------------------------------------------
# https://api.slack.com/apps -> create app -> install to workspace
# Bot token starts with xoxb-, Team ID looks like T01234ABCDE
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# --- Browserbase (cloud browser automation) -------------------------------
# https://www.browserbase.com/settings
# Note: the global `browse` CLI is a separate path and uses its own auth.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# =======================================================================
# OAuth-only MCPs (no secret needed here, just authenticate on first use):
#   - vercel        https://mcp.vercel.com
#   - github        https://api.githubcopilot.com/mcp/
#   - linear        https://mcp.linear.app/sse
#   - readwise      https://highlights-mcp.readwise.io/
#   - descript      https://api.descript.com/v2/mcp
#
# No-auth local MCPs (just need the right runtime installed):
#   - filesystem    requires Node (npx)
#   - fetch         requires uv (uvx)
#   - excalidraw    requires Node (npx)
# =======================================================================
