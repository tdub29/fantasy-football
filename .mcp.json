{
  "$schema": "https://json.schemastore.org/mcp",
  "mcpServers": {
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "linear": {
      "type": "sse",
      "url": "https://mcp.linear.app/sse"
    },
    "readwise": {
      "type": "http",
      "url": "https://highlights-mcp.readwise.io/"
    },
    "descript": {
      "type": "http",
      "url": "https://api.descript.com/v2/mcp"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/TrevorWhite/Downloads/Big Projects/Fantasy Football"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "excalidraw": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp_excalidraw"
      ]
    },
    "fal": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "fal-mcp-server"
      ],
      "env": {
        "FAL_KEY": "${FAL_KEY}"
      }
    },
    "slack": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@slack/mcp-server"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "browserbase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@browserbasehq/mcp-server-browserbase"
      ],
      "env": {
        "BROWSERBASE_API_KEY": "${BROWSERBASE_API_KEY}",
        "BROWSERBASE_PROJECT_ID": "${BROWSERBASE_PROJECT_ID}"
      }
    },
    "codebase-memory": {
      "type": "stdio",
      "command": "C:/Users/TrevorWhite/tools/codebase-memory-mcp/codebase-memory-mcp.exe",
      "args": []
    },
    "ponytail": {
      "command": "node",
      "args": [
        "C:/Users/TrevorWhite/Downloads/Big Projects/.agents/vendor/DietrichGebert-ponytail/ponytail-mcp/index.js"
      ],
      "type": "stdio"
    },
    "caveman-shrink-filesystem": {
      "command": "node",
      "args": [
        "C:/Users/TrevorWhite/Downloads/Big Projects/.agents/vendor/JuliusBrussee-caveman/src/mcp-servers/caveman-shrink/index.js",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/TrevorWhite/Downloads/Big Projects/Fantasy Football"
      ],
      "type": "stdio"
    },
    "caveman-shrink-codebase-memory": {
      "command": "node",
      "args": [
        "C:/Users/TrevorWhite/Downloads/Big Projects/.agents/vendor/JuliusBrussee-caveman/src/mcp-servers/caveman-shrink/index.js",
        "C:/Users/TrevorWhite/tools/codebase-memory-mcp/codebase-memory-mcp.exe"
      ],
      "type": "stdio"
    }
  }
}
