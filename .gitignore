# Higgins trade sim scratch: raw run output, regenerated by site/js/trade-sim-higgins-counters.js
# The keepable copy lives in notes/higgins-trade-sim-2026-09-16/
.sim-out/

# Browser profiles and scrape caches. Regenerated by the fetchers on every run,
# and the PrizePicks one alone is 82 MB. Nothing downstream reads them directly.
projections/.pp-profile/
projections/_prizepicks-*-raw.json
projections/*.bak
site/data/_pp_profile/

# Verification screenshots. verify-app.py rewrites these on every run, so they
# are output, not source, and they churn the diff on every check.
.agents/verify-shots/
.agents/state/
.agents/artifacts/
*.bak-pc

# Local trash. Things moved aside rather than deleted, because the workspace
# guard prefers a recoverable path over a hard delete. Not project content.
.trash/

# Editor and script backups. Git is the backup.
*.bak-*
*.before-*

# nflverse raw downloads for build_nflverse_suite.py, refetched every run (6h TTL)
projections/nflverse-cache/

# One-day OCR crops from the 2026-08-22 Gibbs ingest. Kept on disk, not in git.
site/data/_shots/_crop/
site/_shots/
